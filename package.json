{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @omtre/core build && pnpm --filter omtre build",
    "build:core": "pnpm --filter @omtre/core build",
    "build:cli": "pnpm --filter omtre build",
    "test": "pnpm --filter @omtre/core test && pnpm --filter omtre test",
    "test:core": "pnpm --filter @omtre/core test",
    "test:cli": "pnpm --filter omtre test",
    "lint": "pnpm --filter @omtre/core lint && pnpm --filter omtre lint",
    "typecheck": "pnpm --filter @omtre/core build && pnpm --filter omtre typecheck",
    "release": "pnpm --filter omtre release",
    "release:minor": "pnpm --filter omtre release:minor",
    "release:major": "pnpm --filter omtre release:major",
    "release:beta": "pnpm --filter omtre release:beta",
    "release:rc": "pnpm --filter omtre release:rc",
    "release:promote": "pnpm --filter omtre release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
