{
  "onUserMessage": [
    {
      "description": "Prepend Omtre breadcrumb on each user message (UI keeps original typed text)",
      "hooks": [
        {
          "type": "command",
          "command": "python -X utf8 .snow/hooks/write-omtre-context.py user",
          "timeout": 15000,
          "enabled": true
        }
      ]
    }
  ]
}
