{
  "name": "omtre",
  "version": "1.0.0",
  "description": "Contract-enforced workflow harness for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "omtre": "./bin/omtre.js",
    "omt": "./bin/omtre.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc && pnpm run copy-templates",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy-templates": "node scripts/copy-templates.js",
    "dev": "tsc --watch",
    "start": "node ./dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "lint:py": "basedpyright",
    "lint:all": "pnpm lint && pnpm lint:py",
    "prepack": "node scripts/copy-package-assets.js && node scripts/bundle-core.js prepack",
    "postpack": "node scripts/bundle-core.js postpack && node scripts/clean-package-assets.js",
    "prepublishOnly": "pnpm test && pnpm run build",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:beta": "node scripts/release.js beta",
    "release:rc": "node scripts/release.js rc",
    "release:promote": "node scripts/release.js promote",
    "manifest": "node scripts/create-manifest.js"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "workflow",
    "cursor",
    "claude-code",
    "codex",
    "spec-driven-development",
    "agent-skills",
    "cli",
    "developer-tools",
    "omtre"
  ],
  "author": "ScoFan (https://github.com/ScoFan-official)",
  "homepage": "https://github.com/ScoFan-official/omtre#readme",
  "bugs": {
    "url": "https://github.com/ScoFan-official/omtre/issues"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@omtre/core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.9.4",
    "giget": "^3.1.1",
    "inquirer": "^9.3.7",
    "undici": "^6.21.0",
    "zod": "^4.4.2"
  },
  "bundleDependencies": [
    "@omtre/core"
  ],
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/figlet": "^1.7.0",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^4.0.18",
    "basedpyright": "^1.37.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ScoFan-official/omtre.git"
  }
}
